# Copy to infra/.env.compose and fill secrets before `docker compose -f infra/docker-compose.yml up`.
POSTGRES_USER=vigil
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vigil
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
ENVIRONMENT=local
REQUIRE_AUTH=false
JWT_SECRET_KEY=local-dev-only-change-me-32chars-min
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VIGIL_FIELD_ENCRYPTION_KEYS=
CORS_ORIGINS=http://localhost:3000
