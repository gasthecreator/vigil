# PRODUCTION profile. Copy to infra/.env.compose, replace every REPLACE_ME value, then:
#   docker compose -f infra/docker-compose.yml --env-file infra/.env.compose up --build
# The API container refuses to start while any REPLACE_ME placeholder remains.
POSTGRES_USER=vigil
POSTGRES_PASSWORD=REPLACE_ME_strong_database_password
POSTGRES_DB=vigil
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
ENVIRONMENT=production
REQUIRE_AUTH=true
# openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_ME_openssl_rand_hex_32
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VIGIL_FIELD_ENCRYPTION_KEYS=REPLACE_ME_fernet_key
# Explicit hospital origin(s); wildcard is rejected in production.
CORS_ORIGINS=https://vigil.example-hospital.local
