# LOCAL DEMO ONLY - INSECURE ON PURPOSE (no authentication, header-claimed roles, throw-away keys).
# Never use on a hospital network. Production uses infra/.env.compose.example.
POSTGRES_USER=vigil
POSTGRES_PASSWORD=local-demo-password
POSTGRES_DB=vigil
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
ENVIRONMENT=local
REQUIRE_AUTH=false
JWT_SECRET_KEY=local-dev-only-change-me-32chars-min
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VIGIL_FIELD_ENCRYPTION_KEYS=
CORS_ORIGINS=http://localhost:3000
