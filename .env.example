# Vigil API configuration (copy to .env; never commit .env).
# Every variable the API reads is listed here. Values below are placeholders, not secrets.

# Profile: local | staging | production. Anything other than "local" forces authentication
# and refuses to start without a strong JWT_SECRET_KEY (apps/api/vigil_api/config.py).
ENVIRONMENT=local

# SQLAlchemy URL. Local default is a SQLite file in the working directory.
DATABASE_URL=sqlite:///./vigil_dev.db

# Required (>= 32 random characters) when ENVIRONMENT != local. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# true/1/yes enables bearer-token authentication in the local profile (always on elsewhere).
REQUIRE_AUTH=false

# Alert threshold on the follow-up risk score (0-1). Changing it needs clinical sign-off.
CLINICAL_ALERT_THRESHOLD=0.75

# Field-level encryption keys (comma-separated, newest first; see docs/runbooks/KEY_ROTATION.md if present).
# Generate each with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VIGIL_FIELD_ENCRYPTION_KEYS=

# File that receives the external audit-chain anchor (tail-deletion detection). Put it on a separate volume.
VIGIL_AUDIT_ANCHOR_PATH=

# Set to 1 to let non-admin operators select the research CP-SAT scheduler (unvalidated in simulation; ADR-0019).
VIGIL_ENABLE_RESEARCH_SCHEDULER=0
